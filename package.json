    "e2e": "python3 tests/e2e.py"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
